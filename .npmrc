# Node package manager configuration

# Resolve from the canonical public registry so committed lockfiles stay
# reproducible for OSS contributors without private feed access.
registry=https://registry.npmjs.org/

# Verify TLS certificates for every registry request
strict-ssl=true

# Fetch lockfile tarballs from the configured registry, not the recorded host
replace-registry-host=always

# Save exact versions in package.json for dependency pinning checks
save-exact=true
