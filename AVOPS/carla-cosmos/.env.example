# Hugging Face read token required to download gated Cosmos Transfer 2.5 weights.
HF_TOKEN=

# CARLA uses one GPU for simulator rendering; Cosmos inference sees all GPUs.
CARLA_GPU_ID=0

# Camera views sent to Cosmos (comma separated, or "all" for the seven-view rig).
# Cosmos needs 4 GPUs for up to four views and 8 GPUs for five to eight (6 is not a valid size).
# CARLA_COSMOS_VIEWS=front_wide,cross_left,cross_right,rear_left,rear_right,rear
CARLA_COSMOS_VIEWS=all

# CUDA devices used by Cosmos multi-view inference. Empty keeps the legacy layout
# (all eight GPUs). Set exactly as many devices as the context-parallel size needs:
# 4 for up to four views, 8 for five to eight.
COSMOS_GPU_IDS=
