############################################
# Zero-NGC OSMO Closed-Loop AVOps Configuration
#
# Copy to AVOPS/configs/closed-loop.env (git-ignored) and adjust values:
#   cp AVOPS/configs/closed-loop.env.example AVOPS/configs/closed-loop.env
############################################

# Input driving clips and run output workspace (local paths on host).
AVOPS_INPUT_DIR=
AVOPS_WORK_DIR=

# Hugging Face token with accepted terms for nvidia/Cosmos-Reason2-2B and nvidia/Cosmos3-Nano-FP8.
# No NGC_API_KEY is required.
HF_TOKEN=

# Stage 2 & 4: Cosmos-Reason2-2B OpenAI-compatible VLM endpoint (served on 1x GPU).
ODD_IMAGE=odd-component:latest
ODD_VLM_URL=http://127.0.0.1:8010/v1
ODD_VLM_MODEL=nvidia/Cosmos-Reason2-2B
ODD_VLM_REVISION=9ce19a195e423419c349abfc86fd07178b230561
ODD_VLM_INPUT=video
ODD_THRESHOLD=0.8

# Stage 3: Cosmos3-Nano-FP8 vLLM-Omni endpoint (served on 1x GPU).
COSMOS3_URL=http://127.0.0.1:8000
COSMOS3_REVISION=9d45b0910219989a76c56aae82a08007bc1b597e
COSMOS3_MODE=auto
COSMOS3_SIZE=854x480
COSMOS3_NUM_FRAMES=97
COSMOS3_FPS=24
COSMOS3_STEPS=35
COSMOS3_GUIDANCE=6.0
COSMOS3_FLOW_SHIFT=10.0
COSMOS3_SEED=17
COSMOS3_TIMEOUT=900
AVOPS_MAX_CLIPS=6

# OSMO submission defaults.
OSMO_POOL=default
