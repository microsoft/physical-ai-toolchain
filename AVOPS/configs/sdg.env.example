############################################
# SDG Workflow — Environment Configuration
#
# Copy to configs/sdg.env (git-ignored) and fill in values:
#   cp configs/sdg.env.example configs/sdg.env
# Used by scripts/sdg.sh. The SDG workflow repo stays external.
############################################

# Absolute path to the external sdg-workflow checkout (required).
SDG_WORKFLOW_DIR=../sdg-workflow

# Kubeconfig of the target cluster (required, single file).
KUBECONFIG=

# Required secrets.
NGC_API_KEY=
HF_TOKEN=

# Optional secrets.
OSMO_TOKEN=
VLM_API_KEY=
LLM_API_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Airflow controller image (passed through to make).
AIRFLOW_IMAGE_REPOSITORY=
AIRFLOW_IMAGE_TAG=

# NFS storage overrides (passed through to make).
NFS_NAMESPACE=nfs-system
NFS_STORAGE_CLASS=nfs
NFS_EXPORT_PATH=/srv/nfs/k8s
NFS_NODE_HOSTNAME=
NFS_SERVER=

# Airflow REST API used by `sdg.sh trigger`.
AIRFLOW_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
SDG_DAG_ID=autonomous_vehicle_dataset_generation_dag_k8s

# ODD gap analysis run between curation and generation by `sdg.sh pipeline`.
# The component in AVOPS/ODD is built locally on first use. All optional; the values below are the defaults.
ODD_IMAGE=odd-component:latest
ODD_VLM_URL=http://127.0.0.1:8010/v1
ODD_VLM_MODEL=nvidia/Cosmos-Reason2-2B
# What the VLM sees: the whole clip (video) or only its first frame (frame).
ODD_VLM_INPUT=video
ODD_THRESHOLD=0.8
# Set to 1 to use heuristic mock perception instead of a live VLM endpoint.
ODD_MOCK_VLM=
# Cap on generation runs triggered from ODD gaps (empty or 0 = no cap).
ODD_MAX_RUNS=
# Seconds between DagRun state polls and the maximum wait per run.
SDG_POLL_INTERVAL=30
SDG_RUN_TIMEOUT=21600

# CARLA backend (`sdg.sh --backend carla pipeline` or `sdg.sh carla <odd-dir>`), see AVOPS/carla-cosmos.
# All optional; the values below are the defaults. Cosmos needs 8 GPUs for 5-8 views (six views included)
# and 4 GPUs for up to 4 views, e.g. CARLA_COSMOS_VIEWS=front_wide,cross_left,cross_right,rear with 4 GPU IDs.
CARLA_COSMOS_VIEWS=front_wide,cross_left,cross_right,rear_left,rear_right,rear
COSMOS_GPU_IDS=0,1,2,3,4,5,6,7
# GPU CARLA renders on (about 6 GB); it shares a Cosmos GPU when Cosmos uses all eight.
CARLA_GPU_ID=7
