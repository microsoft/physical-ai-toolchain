# Local development against Azure Blob Storage
#
# Usage:
#   1. Copy to .env:  cp .env.azure.example .env
#   2. Log in:        az login  (or source infrastructure/terraform/prerequisites/az-sub-init.sh)
#   3. Start:         npm run dev:backend  (from data-management/viewer/)
#
# Read-only browsing needs Storage Blob Data Reader on the dataset container.
# Saving annotations needs Storage Blob Data Contributor on the annotation container.
# Labels and durable judge jobs currently need Contributor on the dataset container too.
# Scope these data roles to the required containers rather than the whole account.
# Do NOT set AZURE_CLIENT_ID locally — it overrides CLI credentials with managed identity.
# This file selects storage only; see .env.example for authentication and other settings.

STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_NAME=<insert-storage-account-name>
AZURE_STORAGE_DATASET_CONTAINER=datasets
AZURE_STORAGE_ANNOTATION_CONTAINER=annotations

# Optional VLM judge: disabled until dependencies and inference are configured.
# Azure Blob storage does not supply a GPU. Use openai-compat for a remote model,
# qwen3-vl only on a suitable NVIDIA GPU host, or echo for model-free tests.
# See .env.example for model, revision, endpoint, secret and cache settings.
VLM_JUDGE_ENABLED=false
# VLM_JUDGE_BACKEND=echo

# Shared inference limit and scope; use identical values across competing workers.
# VLM_JUDGE_CAPACITY=1
# VLM_JUDGE_CAPACITY_SCOPE=configured-inference-device

# Azure jobs persist in the dataset container, not local scratch or the annotation container.
# VLM_JUDGE_JOB_DIR is local-only and has no effect in Azure mode.
# Inference cache is disposable and does not replace durable job state.
