# Dataviewer Backend Environment Configuration
# Copy this file to .env and fill in your local values.

# ─────────────────────────────────────────────────────────────────────────────
# Storage backend
# ─────────────────────────────────────────────────────────────────────────────

# Active storage backend: local (default) | azure
# Use 'azure' to connect directly to Azure Blob Storage via DefaultAzureCredential
# or a SAS token. Use 'local' for local filesystem access via DATA_DIR.
STORAGE_BACKEND=local

# ─────────────────────────────────────────────────────────────────────────────
# Local storage (used when STORAGE_BACKEND=local)
# ─────────────────────────────────────────────────────────────────────────────

# Path to the directory containing datasets.
# Each subdirectory is treated as a dataset_id.
# Relative paths are resolved from this file's directory (backend/).
DATA_DIR=../../../datasets

# ─────────────────────────────────────────────────────────────────────────────
# Azure Blob Storage (required when STORAGE_BACKEND=azure)
# ─────────────────────────────────────────────────────────────────────────────
# Prerequisite: run `az login` or `source infrastructure/terraform/prerequisites/az-sub-init.sh`
# Read-only browsing needs Storage Blob Data Reader on the dataset container.
# Saving annotations needs Storage Blob Data Contributor on the annotation container.
# Labels and durable judge jobs currently use the dataset container and need
# Storage Blob Data Contributor there too. Scope roles to the required containers.
# Do NOT set AZURE_CLIENT_ID locally — it overrides CLI credentials.
# See .env.azure.example for a ready-to-copy config.

# Azure Storage account name
# AZURE_STORAGE_ACCOUNT_NAME=

# Blob container that holds dataset files (videos, parquet, HDF5).
# Expected structure: {dataset_id}/meta/info.json, {dataset_id}/videos/...
# AZURE_STORAGE_DATASET_CONTAINER=datasets

# Blob container that holds annotation JSON files.
# Defaults to AZURE_STORAGE_DATASET_CONTAINER when not set.
# AZURE_STORAGE_ANNOTATION_CONTAINER=annotations

# SAS token for Azure Blob authentication.
# When not set, DefaultAzureCredential uses the available configured credentials
# (for example, Azure CLI locally or managed identity in Azure).
# Recommended: leave unset in AKS / Container Apps and rely on MSI.
# AZURE_STORAGE_SAS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Server configuration (set for container deployments)
# ─────────────────────────────────────────────────────────────────────────────

# Host address for uvicorn to bind to.
# Use 0.0.0.0 in Docker / AKS so the server is reachable from outside the container.
# BACKEND_HOST=127.0.0.1

# Port for the backend API server.
# BACKEND_PORT=8000

# Uvicorn log level.
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Security middleware
# ─────────────────────────────────────────────────────────────────────────────

# Maximum request body size in bytes.
# Requests exceeding this limit receive HTTP 413. Default: 10 MB.
# MAX_REQUEST_BODY_BYTES=10485760

# Rate limits for detection endpoints (slowapi format, e.g. "10/minute", "100/hour").
# RATE_LIMIT_DETECT=10/minute
# RATE_LIMIT_DETECTIONS=120/minute

# Absolute directory containing approved YOLO weight files named `<model-identifier>.pt`.
# Container deployments mount this directory read-only at /models.
# DETECTION_MODELS_DIR=/models

# JSON object mapping every active model identifier to its reviewed SHA-256 digest.
# DETECTION_MODEL_DIGESTS={"yolo11n":"<64-character-sha256>","yolov8s-world":"<64-character-sha256>"}

# Maximum cached episode summaries and their time-to-live in seconds.
# DETECTION_CACHE_MAX_SIZE=100
# DETECTION_CACHE_TTL_SECONDS=3600

# Default confidence threshold when a detection request omits `confidence`.
# DETECTION_CONFIDENCE_THRESHOLD=0.1

# ─────────────────────────────────────────────────────────────────────────────
# CORS (set for container / cloud deployments)
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Add your frontend URL (e.g. https://dataviewer.example.com) for cloud deployments.
# Defaults to localhost dev ports when not set.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─────────────────────────────────────────────────────────────────────────────
# Cache configuration
# ─────────────────────────────────────────────────────────────────────────────

# Maximum number of decoded episodes retained in the in-memory LRU cache.
# EPISODE_CACHE_CAPACITY=32

# Maximum approximate episode cache size in MiB.
# EPISODE_CACHE_MAX_MB=100

# Directory for transcoded video cache files. The application default is used when unset.
# VIDEO_TRANSCODE_CACHE_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Test configuration (used by pytest integration tests)
# ─────────────────────────────────────────────────────────────────────────────

# Base path containing test datasets. Defaults to ../../datasets relative to tests/.
# TEST_DATASET_PATH=../datasets

# Dataset ID (subdirectory name) used by integration tests.
# Must exist under TEST_DATASET_PATH. Defaults to lerobot.
# TEST_DATASET_ID=lerobot

# ============================================================================
# Authentication
# ============================================================================

# Set to "true" to disable authentication and CSRF checks in local development.
# NEVER enable this in production.
DATAVIEWER_AUTH_DISABLED=true

# Set to "true" when the server is behind HTTPS (marks the csrf_token cookie Secure).
# Always set this to "true" in production.
DATAVIEWER_SECURE_COOKIES=false

# ============================================================================
# Curated release API (operator-owned; clients never see these paths)
# ============================================================================

# Absolute directory holding durable release job state. Leave empty to disable the API.
RELEASE_JOB_ROOT=
# JSON object mapping destination aliases to operator-owned absolute paths.
# Example shape only: {"<alias>": "<absolute-path>"}
RELEASE_DESTINATIONS=

# Authentication provider: "apikey" (default), "azure_ad", "auth0", or "easy_auth".
DATAVIEWER_AUTH_PROVIDER=apikey

# --- API key provider ---
# Secret key that clients must send in the X-API-Key header.
DATAVIEWER_API_KEY=

# --- Azure AD / Entra ID provider (DATAVIEWER_AUTH_PROVIDER=azure_ad) ---
# Azure tenant ID (GUID).
DATAVIEWER_AZURE_TENANT_ID=
# Azure AD application (client) ID used as the JWT audience.
DATAVIEWER_AZURE_CLIENT_ID=

# --- Release identity and headless requests ---
# Local no-auth mode uses localuser as author/owner automatically. No release
# grants, credentials or contributor-label configuration are needed locally.
# Trusted authenticated users need no additional release roles or grants.
# Existing saved-resource ownership/scoping and configured storage confinement
# still apply. Application identity is separate from worker Blob credentials.
# Headless clients retain authenticated GET /api/csrf-token Set-Cookie values and
# send the returned csrf_token as X-CSRF-Token plus that cookie on each mutation.
# Authentication credentials are still required. Client-type headers never exempt
# CSRF. Hosted application-principal ingress requires independent target proof;
# a developer Azure CLI token does not establish app-only ingress support.

# --- Release planning limits ---
# Read after application environment loading. Estimates remain advisory until
# durable admission and runtime enforcement; these settings do not choose roots.
# Maximum processing working-memory budget, positive bytes. Default: 2 GiB.
# CURATION_RELEASE_PROCESSING_MEMORY_BYTES=2147483648
# Nonnegative capacity reserve per volume. Default: 1 GiB.
# CURATION_RELEASE_RESERVE_BYTES=1073741824
# Positive output-size estimate multiplier for selected media, as a percentage.
# Default: 100. Values above 100 allow estimated encoding growth; not a hard cap.
# CURATION_RELEASE_TRANSCODE_OUTPUT_PERCENT=100

# --- Release durable worker limits ---
# Optional remote job-state location; RELEASE_JOB_ROOT remains the local scratch root.
# Omit to keep job records local. Use the same values for API and worker processes.
# RELEASE_JOB_STORAGE={"account_url":"https://ACCOUNT.blob.core.windows.net","container":"release-state","prefix":"jobs"}
# Pass ReleaseRuntimeSettings.from_environment(os.environ) to the release store
# after loading this environment. Library composition is explicit; these do not
# enable a public submission endpoint or select storage roots.
# Lease duration, integer seconds in [5, 3600]. Heartbeat <= min(5, lease/4).
# CURATION_RELEASE_LEASE_SECONDS=60
# OS address-space cap for each native child, bytes; minimum 64 MiB.
# CURATION_RELEASE_MEMORY_BYTES=8589934592
# TERM grace before KILL, integer seconds in [0, 3600].
# CURATION_RELEASE_GRACE_SECONDS=5
# Guardian controller-liveness window, integer seconds in [1, 86400]; must
# cover four heartbeat intervals. Missing proof remains unresolved after expiry.
# CURATION_RELEASE_GUARDIAN_SECONDS=30
# Filesystem lock / Blob coordination timeout, integer seconds in [1, 300].
# CURATION_RELEASE_STATE_TIMEOUT_SECONDS=30
# Per-job JSON document bound, bytes in [1, 16777216]. No database is required.
# CURATION_RELEASE_STATE_MAX_RECORD_BYTES=16777216
# Total scanned JSON bytes, in [1, 67108864], at least the per-record bound.
# CURATION_RELEASE_STATE_MAX_TOTAL_BYTES=67108864
# Aggregate metadata byte budget for one retained-release read; must be positive.
# CURATION_RELEASE_READ_METADATA_BYTES=67108864
# Maximum bytes buffered for one retained-release media response; must be positive.
# CURATION_RELEASE_READ_MEDIA_BYTES=536870912
# Maximum jobs admitted/scanned beneath the chosen state root, in [1, 4096].
# Reads never prune records automatically when a configured bound is reached.
# CURATION_RELEASE_STATE_MAX_JOBS=4096
# Named Blob release read/discovery verification: total seconds in (0, 3600].
# Read on provider construction after environment loading, not at module import.
# CURATION_RELEASE_ADMISSION_TIMEOUT_SECONDS=30
# Total independently streamed bytes per admission, in [1, 4398046511104].
# Default 4 GiB; increase for larger releases along with the deadline if needed.
# Exceeded bounds refuse release reads/discovery; there is no legacy fallback.
# CURATION_RELEASE_ADMISSION_MAX_BYTES=4294967296
# Total runtime-proof recovery budget per bounded batch, seconds in [0, 3600].
# CURATION_RELEASE_RECOVERY_SECONDS=30
# Private scratch cleanup traversal budget, integer seconds in [1, 3600].
# Unresolved ownership or exhausted budgets retain the workspace and charge.
# CURATION_RELEASE_CLEANUP_SECONDS=30
# Application ceiling for reserved bytes across all Blob release jobs for one
# account, integer bytes in [1, 4398046511104]. Default 1 TiB. This is not a
# measured Azure capacity. Blob jobs never stat local disk.
# CURATION_RELEASE_BLOB_RESERVATION_LIMIT_BYTES=1099511627776

# --- Easy Auth provider (DATAVIEWER_AUTH_PROVIDER=easy_auth) ---
# Requires DATAVIEWER_AZURE_TENANT_ID and DATAVIEWER_AZURE_CLIENT_ID above.
# Object and client IDs of the trusted frontend user-assigned managed identity.
# DATAVIEWER_CALLER_OBJECT_ID=
# DATAVIEWER_CALLER_CLIENT_ID=

# Positive integer limits for forwarded caller proof and Easy Auth principals.
# Unset values retain these defaults. Invalid values fail hosted startup.
# DATAVIEWER_MAX_CALLER_TOKEN_BYTES=8192
# DATAVIEWER_MAX_PRINCIPAL_ENCODED_BYTES=8192
# DATAVIEWER_MAX_PRINCIPAL_DECODED_BYTES=6144
# DATAVIEWER_MAX_PRINCIPAL_CLAIMS=64
# DATAVIEWER_MAX_PRINCIPAL_VALUE_BYTES=2048

# Positive integer JWKS cache lifetime, network timeout and total caller timeout.
# Values are in seconds. The caller timeout includes waiting for the verifier lock.
# DATAVIEWER_AUTH_JWKS_CACHE_SECONDS=300
# DATAVIEWER_AUTH_JWKS_TIMEOUT_SECONDS=5
# DATAVIEWER_AUTH_CALLER_TIMEOUT_SECONDS=6

# --- Auth0 provider (DATAVIEWER_AUTH_PROVIDER=auth0) ---
# Auth0 tenant domain, e.g. "your-tenant.us.auth0.com".
DATAVIEWER_AUTH0_DOMAIN=
# Auth0 API audience (identifier), e.g. "https://api.dataviewer.example.com".
DATAVIEWER_AUTH0_AUDIENCE=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend MSAL Configuration (build-time, used by Vite)
# ─────────────────────────────────────────────────────────────────────────────

# Azure AD client ID for frontend MSAL authentication.
# Same value as DATAVIEWER_AZURE_CLIENT_ID.
# VITE_AZURE_CLIENT_ID=

# Azure AD tenant ID for frontend MSAL authentication.
# Same value as DATAVIEWER_AZURE_TENANT_ID.
# VITE_AZURE_TENANT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend Nginx Configuration (runtime)
# ─────────────────────────────────────────────────────────────────────────────

# Backend host for nginx reverse proxy.
# Docker Compose default: backend:8000.
# For HTTPS, use the certificate-valid backend FQDN. Custom backend CAs must be
# installed in the frontend container's /etc/ssl/certs/ca-certificates.crt bundle.
# NGINX_BACKEND_HOST=backend:8000
# NGINX_BACKEND_SCHEME=http

# Hosted nginx uses managed_identity mode and the caller-helper sidecar.
# DATAVIEWER_CALLER_MODE=managed_identity

# ─────────────────────────────────────────────────────────────────────────────
# VLM-as-Judge (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Enables episode judge endpoints and the durable /api/judge job lifecycle.
# Use start.sh to select frozen evaluator dependencies; approve restores/downloads first.
# VLM_JUDGE_ENABLED=false

# Backend kind: 'qwen3-vl' (local GPU), 'openai-compat' (remote model), 'echo' (no model).
# Local Qwen needs a suitable CUDA-capable NVIDIA GPU; RTX is not required.
# Remote clients and echo need no local GPU. Azure storage does not select inference hardware.
# VLM_JUDGE_BACKEND=echo

# Hugging Face model ID or explicit local directory (qwen3-vl).
# Local directories must be absolute or start with ./ or ../ and load offline.
# For openai-compat, use the remote model name or Azure OpenAI deployment name.
# VLM_JUDGE_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct

# Required full 40-hex commit SHA for a qwen3-vl Hub model; empty is rejected.
# Leave unset for explicit local model directories (a revision is rejected there).
# Echo and openai-compat backends do not require an HF revision.
# For remote inference, match the deployed weights; this setting cannot pin the remote server.
# VLM_JUDGE_MODEL_REVISION=

# OpenAI-compatible chat completions base URL when VLM_JUDGE_BACKEND=openai-compat.
# Include /v1 where required. Selected frames and saved instructions are sent here.
# Use an approved authenticated endpoint; do not expose the unauthenticated shim publicly.
# For Azure OpenAI: https://<resource-name>.openai.azure.com/openai/v1/
# VLM_JUDGE_BASE_URL=

# API key for non-Azure openai-compat backends (or set OPENAI_API_KEY).
# Use a platform secret reference in deployments; never commit credentials.
# Azure development authentication ignores static keys and refreshes tokens automatically.
# Production inference managed-identity support is deferred; never store bearer tokens here.
# VLM_JUDGE_API_KEY=

# Frames sampled per episode (default: 12).
# VLM_JUDGE_N_FRAMES=12

# Process-reward method: 'gvl' (shuffle-and-rank, needs a capable model) or
# 'chronological' (fuller curves with small local models).
# VLM_JUDGE_PROCESS_METHOD=gvl

# Optional fallback inference cache, not durable job or evidence storage.
# Viewer jobs select a per-dataset/snapshot cache independently of this fallback.
# Leaving this unset disables only the fallback cache, not those per-job caches.
# VLM_JUDGE_CACHE_DIR=outputs/vlm-judge/cache

# Durable local job directory; default: DATA_DIR/.curation/judge.
# Keep it on persistent writable storage, separate from disposable cache.
# Azure mode ignores this path and stores jobs in the dataset container.
# VLM_JUDGE_JOB_DIR=

# Positive shared inference limit; start at 1 and increase only after GPU validation.
# Workers sharing inference capacity must use the same job store, limit and scope.
# VLM_JUDGE_CAPACITY=1
# VLM_JUDGE_CAPACITY_SCOPE=configured-inference-device
