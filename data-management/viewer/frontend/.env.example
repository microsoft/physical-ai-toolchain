# Dataviewer frontend environment configuration.
# Copy this file to .env and replace only the values required for your environment.

# Backend URL used by the Vite development proxy.
VITE_API_BASE_URL=http://localhost:8000

# Entra ID application and tenant IDs. Leave blank to disable MSAL locally.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Comma-separated diagnostics channels. Leave blank to use the defaults.
VITE_DATAVIEWER_DIAGNOSTICS=
