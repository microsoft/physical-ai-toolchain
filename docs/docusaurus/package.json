{
  "name": "physical-ai-toolchain-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "eslint .",
    "lint:label-registry": "node scripts/check-label-registry.mjs",
    "test": "npm run typecheck && npm run build && jest && npm run test:mermaid-a11y",
    "test:coverage": "npm run typecheck && npm run build && jest --coverage && npm run test:mermaid-a11y",
    "test:mermaid-a11y": "node --test scripts/validate-mermaid-accessibility.test.mjs && node scripts/validate-mermaid-accessibility.mjs",
    "generate:test-manifests": "node scripts/generate-deployed-routes.mjs && node scripts/validate-mermaid-accessibility.mjs --write-manifest",
    "serve:ci": "node e2e/static-server.mjs",
    "ci:test:e2e": "npm run build && npm run generate:test-manifests && playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-image-zoom": "3.0.1",
    "mermaid": "11.17.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-github-blockquote-alert": "2.1.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "express": "4.22.1",
    "express-rate-limit": "8.7.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.1",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.1",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "express": "4.22.1",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1",
    "path-to-regexp": "1.9.0",
    "qs": "6.15.2",
    "serialize-javascript": "7.0.5",
    "ws": "8.20.1",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
