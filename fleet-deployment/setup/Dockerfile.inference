# syntax=docker/dockerfile:1.6
# Policy carrier. On the default scratch base it holds only the model and is mounted into consumer
# pods through OCI image volumes (KEP-4639): no runtime, no shell, no packages, never executed.
# On a runtime base it runs as the consumer's own image, such as an OSMO evaluation task.
ARG BASE_IMAGE=scratch
FROM ${BASE_IMAGE}

ARG MODEL_NAME
ARG MODEL_VERSION
ARG MODEL_SOURCE=azureml
LABEL org.opencontainers.image.title="${MODEL_NAME}"
LABEL org.opencontainers.image.version="${MODEL_VERSION}"
LABEL physical-ai-toolchain.model.source="${MODEL_SOURCE}"

# Model artifact tree, materialized by build-model-image.sh under ./model/.
COPY model/ /policy/
