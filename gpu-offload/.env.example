# Machine-local overrides for the gpu-offload mise tasks.
#
# Copy to .env to take effect. The .env file is gitignored and is loaded
# automatically by gpu-offload/mise.toml, so every value here overrides
# auto-detection for every task.
#
#   cp .env.example .env

# Target platform. "auto" inspects the host:
#   /dev/dxg + /usr/lib/wsl      -> wsl-nvidia
#   nvidia-smi + /dev/nvidiactl  -> baremetal-nvidia
#   otherwise                    -> cpu
#
# Set an explicit value to force a path, for example to run the CPU flow on a
# host that has a usable GPU.
#
# Values: auto | cpu | wsl-nvidia | baremetal-nvidia
GPU_OFFLOAD_PLATFORM=auto

# Cluster runtime. "auto" selects k3s for baremetal-nvidia and kind otherwise.
# kind nests the Kubernetes node inside a container, which cannot expose a
# bare-metal GPU through rootless Podman; k3s runs on the host and uses the
# standard NVIDIA container stack.
#
# Values: auto | kind | k3s
GPU_OFFLOAD_RUNTIME=auto

# Python package indexes used when building images. Leave unset to use the
# public PyPI. Set these on hosts that must go through a local mirror.
#PIP_INDEX_URL=https://pypi.org/simple/
#UV_INDEX_URL=https://pypi.org/simple/

# Timeouts, in seconds, for GPU device-plugin readiness.
#GPU_PLUGIN_ROLLOUT_TIMEOUT=600
#GPU_PLUGIN_REGISTER_TIMEOUT=600

# ------------------------------------------------------------------------------
# Host image registry (registry/)
# ------------------------------------------------------------------------------

# Endpoint of the node-local hosting registry that k3s mirrors. Every image built
# here is pushed to it and pulled from it. Point this at an Azure Container
# Registry endpoint to publish there instead.
#GPU_OFFLOAD_REGISTRY_HOST=localhost:5000

# Root for registry blobs on the host. Each registry gets a subdirectory, so the
# hosting store and every cache are kept separate.
#GPU_OFFLOAD_REGISTRY_DATA=/home/user/.local/share/gpu-offload/registry

# Registry image. Pulled once, then served from the local podman store.
#GPU_OFFLOAD_REGISTRY_IMAGE=docker.io/library/registry:2

# Credentials for the pull-through caches declared in registry/upstreams.conf.
# Anonymous access is enough for public images. Set these to raise the Docker Hub
# rate limit or to reach private images.
#GPU_OFFLOAD_DOCKERIO_USERNAME=
#GPU_OFFLOAD_DOCKERIO_PASSWORD=
#GPU_OFFLOAD_GHCR_USERNAME=
#GPU_OFFLOAD_GHCR_PASSWORD=

# NGC. The username is always the literal $oauthtoken; the password is the API key.
#GPU_OFFLOAD_NVCR_USERNAME=$oauthtoken
#GPU_OFFLOAD_NVCR_PASSWORD=

# Azure Container Registry. Setting the name activates the matching row in
# registry/upstreams.conf, so ACR images are cached on the host too.
#GPU_OFFLOAD_ACR_NAME=
#GPU_OFFLOAD_ACR_USERNAME=
#GPU_OFFLOAD_ACR_PASSWORD=

# ------------------------------------------------------------------------------
# ur10e-single example (examples/ur10e-single)
# ------------------------------------------------------------------------------

# The ur10e-single deployment checked out beside this repository. Its
# pyproject.toml, uv.lock, and script directory are staged into the image build.
# Defaults to <repo-parent>/ur10e-single.
#UR10E_SOURCE_PATH=/path/to/ur10e-single

# Directory on the GPU node holding the trained pi05 checkpoint (config.json,
# model.safetensors, and the saved processor pipelines). Defaults to
# $HOME/pi05_ur10e_ik_20k/pretrained_model.
#UR10E_MODEL_HOST_PATH=/path/to/pi05/pretrained_model

# HuggingFace cache on the GPU node. pi05 loads the gated PaliGemma tokenizer and
# the pods run offline, so the tokenizer must already be cached there.
#UR10E_HF_CACHE_HOST_PATH=/home/user/.cache/huggingface

# self-check drives the policy with synthetic observations and needs no robot.
# headless drives a connected UR10e from a terminal with no display or dataset.
# record runs the lerobot-record loop against a connected UR10e.
#UR10E_MODE=self-check

# headless mode. MAX_STEPS of 0 runs until interrupted; HOME_SPEED is the joint
# speed for the moves to the home pose taken before and after the run.
#UR10E_MAX_STEPS=0
#UR10E_HOME_SPEED=0.2

# Python interpreter used by the host-side headless runner. Defaults to the
# ur10e-single virtualenv.
#UR10E_PYTHON=/path/to/ur10e-single/.venv/bin/python

# Namespace for the control deployment. The controller creates the GPU server
# stage in the same namespace.
#UR10E_NAMESPACE=gpu-offload-ur10e
