FROM python:3.12-slim

ARG PIP_INDEX_URL

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install Python deps only (no apt-get, no runtime installs)
RUN pip install --no-cache-dir kubernetes==34.1.0 PyYAML==6.0.2

# Copy controller code
COPY . /app

# Run as non-root
RUN adduser --disabled-password --gecos "" appuser || true
USER appuser

EXPOSE 8443

CMD ["python3", "/app/mutate.py", "--host", "0.0.0.0", "--port", "8443"]
