FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install Python deps only (no apt-get, no runtime installs). PIP_INDEX_URL is
# passed as a BuildKit secret, not a build arg, so a credential embedded in it
# never lands in image history.
RUN --mount=type=secret,id=PIP_INDEX_URL,env=PIP_INDEX_URL \
    pip install --no-cache-dir kubernetes==35.0.0 PyYAML==6.0.2

# Copy controller code
COPY . /app

# Run as non-root
RUN adduser --disabled-password --gecos "" appuser || true
USER appuser

EXPOSE 8443

CMD ["python3", "/app/mutate.py", "--host", "0.0.0.0", "--port", "8443"]
