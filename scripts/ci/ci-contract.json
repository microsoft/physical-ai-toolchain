{
  "version": 1,
  "orchestrators": {
    "pr": { "path": ".github/workflows/pr-validation.yml", "events": ["pull_request"], "aggregate": "pr-validation-summary" },
    "main": { "path": ".github/workflows/main.yml", "events": ["push"], "aggregate": "release-please" },
    "docs": { "path": ".github/workflows/deploy-docs.yml", "events": ["push", "workflow_dispatch"] }
  },
  "secondaryCallers": {
    ".github/workflows/weekly-validation.yml": {
      "events": ["schedule", "workflow_dispatch"],
      "jobs": { "msdate-freshness": "msdate-freshness-check.yml", "container-rescan": "container-scan.yml" }
    }
  },
  "permissionProfiles": {
    "read": { "contents": "read" },
    "coverage": { "contents": "read", "id-token": "write" },
    "security": { "contents": "read", "security-events": "write" },
    "codeql": { "contents": "read", "security-events": "write", "actions": "read" },
    "dependency-review": { "contents": "read", "pull-requests": "write" },
    "release-assets": { "contents": "write" },
    "attestation": { "contents": "write", "id-token": "write", "attestations": "write" },
    "release-publish": { "contents": "read", "issues": "write" },
    "pages-build": { "contents": "read", "pages": "write" },
    "pages-deploy": { "pages": "write", "id-token": "write" }
  },
  "outcomeSchemas": {
    "required": { "selected": ["success"], "unselected": ["success", "skipped"] },
    "advisory": { "selected": ["success", "failure", "cancelled", "skipped"], "unselected": ["success", "failure", "cancelled", "skipped"] },
    "coordination": { "selected": ["success"], "unselected": ["skipped"] }
  },
  "sharedPatterns": ["^\\.github/(workflows|actions)/", "^scripts/(ci|linting|lib|tests)/", "^(package(-lock)?\\.json|codecov\\.yml)$"],
  "dependencyGroups": {
    "python": ["^(pyproject\\.toml|uv\\.lock)$", "^tests/(conftest\\.py|__init__\\.py|fixtures/)"],
    "images": ["^shared/ci/", "^scripts/lib/common\\.sh$", "(^|/)defaults\\.conf$"],
    "viewer": ["^data-management/viewer/(pyproject\\.toml|uv\\.lock|package(-lock)?\\.json|docker-compose[^/]*|Dockerfile[^/]*)$"],
    "gpu": ["^gpu-offload/(pyproject\\.toml|uv\\.lock|mise\\.toml|\\.env\\.example)$"]
  },
  "selectors": {
    "training": { "patterns": ["^training/"], "groups": ["python"] },
    "rl": { "patterns": ["^training/(rl|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "il": { "patterns": ["^training/(il|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "vla": { "patterns": ["^training/(vla|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "evaluation": { "patterns": ["^evaluation/", "^training/il/lerobot/"], "groups": ["python", "images"] },
    "osmo_replay": { "patterns": ["^workflows/osmo/", "^training/utils/"], "groups": ["python", "images"] },
    "dm_tools": { "patterns": ["^data-management/tools/"], "groups": ["python"] },
    "data_pipeline": { "patterns": ["^data-pipeline/"], "groups": ["python"] },
    "inference": { "patterns": ["^fleet-deployment/inference/", "^training/il/lerobot/"], "groups": ["python"] },
    "gpu_offload": { "patterns": ["^gpu-offload/(controller|runtime)/"], "groups": ["python", "gpu"] },
    "gpu_offload_e2e": { "patterns": ["^gpu-offload/(controller|runtime|helm|scripts|registry|examples)/"], "groups": ["python", "gpu"] },
    "shared_ci": { "patterns": ["^shared/ci/"], "groups": ["python"] },
    "dv_backend": { "patterns": ["^data-management/viewer/backend/", "^data-management/viewer/specifications/language-tag-corpus\\.json$", "^evaluation/vlm_judge/"], "groups": ["python", "images", "viewer"] },
    "dv_frontend": { "patterns": ["^data-management/viewer/frontend/", "^data-management/viewer/specifications/language-tag-corpus\\.json$"], "groups": ["viewer"] },
    "fuzz": { "patterns": ["^tests/", "^data-management/viewer/backend/", "^training/"], "groups": ["python"] },
    "docusaurus": { "patterns": ["^docs/", "^[^/]+\\.md$"], "groups": [] },
    "pester": { "patterns": ["\\.(ps1|psm1|psd1)$"], "groups": [] },
    "containers": { "patterns": ["(^|/)(Dockerfile|Containerfile)[^/]*$", "^scripts/security/(discover-base-images|image-slug)\\.sh$"], "groups": ["images"] }
  },
  "cpuSmoke": { "workflow": ".github/workflows/smoke-cpu.yml", "job": "import-smoke", "domains": ["rl", "il", "vla", "evaluation", "vlm-judge", "osmo-replay"] },
  "smokeInputs": { "rl": ["rl"], "il": ["il"], "vla": ["vla"], "evaluation": ["evaluation"], "osmo_replay": ["osmo_replay"], "dataviewer": ["dv_backend", "dv_frontend"] },
  "lanes": [
    { "id": "changes", "classification": "discovery", "owners": { "pr": "changes" }, "inlineException": "Dependency selection only", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read" },
    { "id": "smoke", "classification": "mandatory", "owners": { "pr": "smoke", "main": "smoke" }, "target": "smoke-cpu.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read" },
    { "id": "workflow-refs-check", "classification": "mandatory", "owners": { "pr": "workflow-refs-check", "main": "workflow-refs-check" }, "target": "workflow-refs-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read" },
    { "id": "spell-check", "classification": "mandatory", "owners": { "pr": "spell-check", "main": "spell-check" }, "target": "spell-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "markdown-lint", "classification": "mandatory", "owners": { "pr": "markdown-lint", "main": "markdown-lint" }, "target": "markdown-lint.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "toml-format", "classification": "mandatory", "owners": { "pr": "toml-format", "main": "toml-format" }, "target": "toml-format.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "table-format", "classification": "mandatory", "owners": { "pr": "table-format", "main": "table-format" }, "target": "table-format.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "frontmatter-validation", "classification": "mandatory", "owners": { "pr": "frontmatter-validation", "main": "frontmatter-validation" }, "target": "frontmatter-validation.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "msdate-freshness", "classification": "mandatory", "owners": { "pr": "msdate-freshness" }, "target": "msdate-freshness-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false } },
    { "id": "psscriptanalyzer", "classification": "mandatory", "owners": { "pr": "psscriptanalyzer", "main": "psscriptanalyzer" }, "target": "ps-script-analyzer.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "yaml-lint", "classification": "mandatory", "owners": { "pr": "yaml-lint", "main": "yaml-lint" }, "target": "yaml-lint.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "link-lang-check", "classification": "mandatory", "owners": { "pr": "link-lang-check", "main": "link-lang-check" }, "target": "link-lang-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "markdown-link-check", "classification": "mandatory", "owners": { "pr": "markdown-link-check", "main": "markdown-link-check" }, "target": "markdown-link-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": true, "main": true } },
    { "id": "dependency-review", "classification": "mandatory", "owners": { "pr": "dependency-review" }, "target": "dependency-review.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "dependency-review" },
    { "id": "dependency-pinning", "classification": "mandatory", "owners": { "pr": "dependency-pinning", "main": "dependency-pinning" }, "target": "dependency-pinning-scan.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "security", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "osv-scanner", "classification": "advisory", "owners": { "pr": "osv-scanner" }, "inlineException": "Advisory OSV action, excluded from required results", "selector": "always", "outcomeSchema": "advisory", "permissionProfile": "security" },
    { "id": "container-scan", "classification": "mandatory", "owners": { "pr": "container-scan", "main": "container-scan" }, "target": "container-scan.yml", "selector": "containers", "outcomeSchema": "required", "permissionProfile": "security", "softFailPolicy": { "pr": true, "main": true } },
    { "id": "pester-tests", "classification": "mandatory", "owners": { "pr": "pester-tests", "main": "pester-tests" }, "target": "pester-tests.yml", "selector": "pester", "outcomeSchema": "required", "permissionProfile": "coverage", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "dataviewer-frontend-tests", "classification": "mandatory", "owners": { "pr": "dataviewer-frontend-tests", "main": "dataviewer-frontend-tests" }, "target": "dataviewer-frontend-tests.yml", "selector": "dv_frontend", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "docusaurus-tests", "classification": "mandatory", "owners": { "pr": "docusaurus-tests", "main": "docusaurus-tests", "docs": "test" }, "target": "docusaurus-tests.yml", "selector": "docusaurus", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false, "docs": false } },
    { "id": "pytest-training", "classification": "mandatory", "owners": { "pr": "pytest-training", "main": "pytest-training" }, "target": "pytest-training.yml", "selector": "training", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "pytest-dm-tools", "classification": "mandatory", "owners": { "pr": "pytest-dm-tools", "main": "pytest-dm-tools" }, "target": "pytest-dm-tools.yml", "selector": "dm_tools", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "pytest-data-pipeline", "classification": "mandatory", "owners": { "pr": "pytest-data-pipeline", "main": "pytest-data-pipeline" }, "target": "pytest-data-pipeline.yml", "selector": "data_pipeline", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "pytest-inference", "classification": "mandatory", "owners": { "pr": "pytest-inference", "main": "pytest-inference" }, "target": "pytest-inference.yml", "selector": "inference", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "pytest-gpu-offload", "classification": "mandatory", "owners": { "pr": "pytest-gpu-offload", "main": "pytest-gpu-offload" }, "target": "pytest-gpu-offload.yml", "selector": "gpu_offload", "outcomeSchema": "required", "permissionProfile": "read" },
    { "id": "gpu-offload-kind-smoke", "classification": "mandatory", "owners": { "pr": "gpu-offload-kind-smoke", "main": "gpu-offload-kind-smoke" }, "target": "gpu-offload-kind-smoke.yml", "selector": "gpu_offload_e2e", "outcomeSchema": "required", "permissionProfile": "read" },
    { "id": "pytest-shared-ci", "classification": "mandatory", "owners": { "pr": "pytest-shared-ci", "main": "pytest-shared-ci" }, "target": "pytest-shared-ci.yml", "selector": "shared_ci", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "dataviewer-backend-pytests", "classification": "mandatory", "owners": { "pr": "dataviewer-backend-pytests", "main": "dataviewer-backend-pytests" }, "target": "dataviewer-backend-pytests.yml", "selector": "dv_backend", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "evaluation-pytests", "classification": "mandatory", "owners": { "pr": "evaluation-pytests", "main": "evaluation-pytests" }, "target": "evaluation-pytests.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "fuzz-regression-tests", "classification": "mandatory", "owners": { "pr": "fuzz-regression-tests", "main": "fuzz-regression-tests" }, "target": "fuzz-regression-tests.yml", "selector": "fuzz", "outcomeSchema": "required", "permissionProfile": "coverage" },
    { "id": "python-lint", "classification": "mandatory", "owners": { "pr": "python-lint", "main": "python-lint" }, "target": "python-lint.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "uv-lock-consistency", "classification": "mandatory", "owners": { "pr": "uv-lock-consistency", "main": "uv-lock-consistency" }, "target": "uv-lock-consistency.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "terraform-lint", "classification": "mandatory", "owners": { "pr": "terraform-lint", "main": "terraform-lint" }, "target": "terraform-lint.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "terraform-validation", "classification": "mandatory", "owners": { "pr": "terraform-validation", "main": "terraform-validation" }, "target": "terraform-validation.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "terraform-security", "classification": "advisory", "owners": { "pr": "terraform-security" }, "target": "terraform-security.yml", "selector": "always", "outcomeSchema": "advisory", "permissionProfile": "security", "softFailPolicy": { "pr": true } },
    { "id": "terraform-tests", "classification": "mandatory", "owners": { "pr": "terraform-tests", "main": "terraform-tests" }, "target": "terraform-tests.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "coverage", "softFailPolicy": { "pr": true, "main": true } },
    { "id": "go-lint", "classification": "mandatory", "owners": { "pr": "go-lint", "main": "go-lint" }, "target": "go-lint.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "terraform-docs-check", "classification": "mandatory", "owners": { "pr": "terraform-docs-check", "main": "terraform-docs-check" }, "target": "terraform-docs-check.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": true, "main": true } },
    { "id": "go-tests", "classification": "mandatory", "owners": { "pr": "go-tests", "main": "go-tests" }, "target": "go-tests.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "coverage", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "shellcheck", "classification": "mandatory", "owners": { "pr": "shellcheck", "main": "shellcheck" }, "target": "shellcheck.yml", "selector": "always", "outcomeSchema": "required", "permissionProfile": "read", "softFailPolicy": { "pr": false, "main": false } },
    { "id": "codeql-analysis", "classification": "mandatory", "owners": { "pr": "codeql-analysis", "main": "codeql-analysis" }, "target": "codeql-analysis.yml", "allowedEvents": ["schedule"], "selector": "always", "outcomeSchema": "required", "permissionProfile": "codeql" },
    { "id": "pr-validation-summary", "classification": "aggregate", "owners": { "pr": "pr-validation-summary" }, "inlineException": "Required-result evaluation only; stable required-check context", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "read" },
    { "id": "release-please", "classification": "release", "owners": { "main": "release-please" }, "inlineException": "Existing release coordination and tag signing, outside validation ownership", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "coverage" },
    { "id": "generate-dependency-sbom", "classification": "release", "owners": { "main": "generate-dependency-sbom" }, "inlineException": "Existing release dependency SBOM publication", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "release-assets" },
    { "id": "attest-release", "classification": "release", "owners": { "main": "attest-release" }, "inlineException": "Existing release artifact signing and attestations", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "attestation" },
    { "id": "sbom-diff", "classification": "release", "owners": { "main": "sbom-diff" }, "inlineException": "Existing advisory release dependency comparison", "selector": "always", "outcomeSchema": "advisory", "permissionProfile": "release-assets" },
    { "id": "append-verification-notes", "classification": "release", "owners": { "main": "append-verification-notes" }, "inlineException": "Existing release verification notes", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "release-assets" },
    { "id": "publish-release", "classification": "release", "owners": { "main": "publish-release" }, "inlineException": "Existing draft promotion and milestone closure", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "release-publish" },
    { "id": "docs-build", "classification": "deployment", "owners": { "docs": "build" }, "inlineException": "Independent Pages deployment artifact build", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "pages-build" },
    { "id": "docs-deploy", "classification": "deployment", "owners": { "docs": "deploy" }, "inlineException": "Independent Pages deployment", "selector": "always", "outcomeSchema": "coordination", "permissionProfile": "pages-deploy" }
  ]
}
