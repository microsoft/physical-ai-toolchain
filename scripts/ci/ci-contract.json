{
  "$comment": "cspell:ignore bridgecrewio autobuild ",
  "version": 1,
  "orchestrators": {
    "pr": { "path": ".github/workflows/pr-validation.yml", "events": ["pull_request"], "aggregate": "pr-validation-summary" },
    "main": { "path": ".github/workflows/main.yml", "events": ["push"], "aggregate": "main-validation-summary" },
    "docs": { "path": ".github/workflows/deploy-docs.yml", "events": ["push", "workflow_dispatch"] }
  },
  "secondaryCallers": {
    ".github/workflows/weekly-validation.yml": {
      "events": ["schedule", "workflow_dispatch"],
      "jobs": { "msdate-freshness": "msdate-freshness-check.yml", "container-rescan": "container-scan.yml" }
    }
  },
  "permissionProfiles": {
    "read": { "contents": "read" },
    "coverage": { "contents": "read", "id-token": "write" },
    "security": { "contents": "read", "security-events": "write" },
    "codeql": { "contents": "read", "security-events": "write", "actions": "read" },
    "dependency-review": { "contents": "read", "pull-requests": "write" },
    "release-assets": { "contents": "write" },
    "attestation": { "contents": "write", "id-token": "write", "attestations": "write" },
    "release-publish": { "contents": "read", "issues": "write" },
    "pages-build": { "contents": "read", "pages": "write" },
    "pages-deploy": { "pages": "write", "id-token": "write" }
  },
  "outcomeSchemas": {
    "required": { "selected": ["success"], "unselected": ["success", "skipped"] },
    "advisory": { "selected": ["success", "failure", "cancelled", "skipped"], "unselected": ["success", "failure", "cancelled", "skipped"] },
    "coordination": { "selected": ["success"], "unselected": ["skipped"] }
  },
  "evidenceAction": {
    "path": ".github/actions/ci-outcome/action.yml",
    "receipt-command": "node \"$GITHUB_ACTION_PATH/../../../scripts/ci/publish-outcome.mjs\"",
    "enforcement-sha256": "2f444203f834223d90060290ad9055844da4b519d649341cafe1bb7b570056be"
  },
  "sharedPatterns": ["^\\.github/(workflows|actions)/", "^scripts/(ci|linting|lib|tests)/", "^(package(-lock)?\\.json|codecov\\.yml)$"],
  "dependencyGroups": {
    "python": ["^(pyproject\\.toml|uv\\.lock)$", "^tests/(conftest\\.py|__init__\\.py|fixtures/)"],
    "images": ["^shared/ci/", "^scripts/lib/common\\.sh$", "(^|/)defaults\\.conf$"],
    "viewer": ["^data-management/viewer/(pyproject\\.toml|uv\\.lock|package(-lock)?\\.json|docker-compose[^/]*|Dockerfile[^/]*)$"],
    "gpu": ["^gpu-offload/(pyproject\\.toml|uv\\.lock|mise\\.toml|\\.env\\.example)$"]
  },
  "selectors": {
    "training": { "patterns": ["^training/"], "groups": ["python"] },
    "rl": { "patterns": ["^training/(rl|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "il": { "patterns": ["^training/(il|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "vla": { "patterns": ["^training/(vla|utils|packaging)/", "^training/[^/]+\\.py$"], "groups": ["python", "images"] },
    "evaluation": { "patterns": ["^evaluation/", "^training/il/lerobot/"], "groups": ["python", "images"] },
    "osmo_replay": { "patterns": ["^workflows/osmo/", "^training/utils/"], "groups": ["python", "images"] },
    "dm_tools": { "patterns": ["^data-management/tools/"], "groups": ["python"] },
    "data_pipeline": { "patterns": ["^data-pipeline/"], "groups": ["python"] },
    "inference": { "patterns": ["^fleet-deployment/inference/", "^training/il/lerobot/"], "groups": ["python"] },
    "gpu_offload": { "patterns": ["^gpu-offload/(controller|runtime)/"], "groups": ["python", "gpu"] },
    "gpu_offload_e2e": { "patterns": ["^gpu-offload/(controller|runtime|helm|scripts|registry|examples)/"], "groups": ["python", "gpu"] },
    "shared_ci": { "patterns": ["^shared/ci/"], "groups": ["python"] },
    "dv_backend": { "patterns": ["^data-management/viewer/backend/", "^data-management/viewer/specifications/language-tag-corpus\\.json$", "^evaluation/vlm_judge/"], "groups": ["python", "images", "viewer"] },
    "dv_frontend": { "patterns": ["^data-management/viewer/frontend/", "^data-management/viewer/specifications/language-tag-corpus\\.json$"], "groups": ["viewer"] },
    "fuzz": { "patterns": ["^tests/", "^data-management/viewer/backend/", "^training/"], "groups": ["python"] },
    "docusaurus": { "patterns": ["^docs/", "^[^/]+\\.md$"], "groups": [] },
    "pester": { "patterns": ["\\.(ps1|psm1|psd1)$"], "groups": [] },
    "containers": { "patterns": ["(^|/)(Dockerfile|Containerfile)[^/]*$", "^scripts/security/(discover-base-images|image-slug)\\.sh$"], "groups": ["images"] }
  },
  "cpuSmoke": { "workflow": ".github/workflows/smoke-cpu.yml", "job": "import-smoke", "domains": ["rl", "il", "vla", "evaluation", "vlm-judge", "osmo-replay"] },
  "smokeInputs": { "rl": ["rl"], "il": ["il"], "vla": ["vla"], "evaluation": ["evaluation"], "osmo_replay": ["osmo_replay"], "dataviewer": ["dv_backend", "dv_frontend"] },
  "execution": {
    "smoke-cpu": {
      "output-job": "outcome",
      "jobs": {
        "import-smoke": {"required-steps":["smoke"],"reports":[],"shards":["cpu-rl","cpu-il","cpu-vla","cpu-evaluation","cpu-vlm-judge","cpu-osmo-replay"],"bindings":{"smoke":{"run-sha256":"99dc481fe8023a71a148221edcda72965aeb7e8fc847485508a4aaeadd31b99c"}},"shard-input":"cpu-${{ matrix.domain }}","matrix":{"domain":["rl","il","vla","evaluation","vlm-judge","osmo-replay"]}},
        "image-smoke-rl": {"required-steps":["smoke"],"reports":[],"shards":["image-rl"],"bindings":{"smoke":{"run-sha256":"0443fa4232f87e0ce561a3061cf5227bf471b6c40cf0480edd6443ca6372aa6f"}},"shard-input":"image-rl","if":"inputs.rl"},
        "image-smoke-il": {"required-steps":["smoke"],"reports":[],"shards":["image-il"],"bindings":{"smoke":{"run-sha256":"9f8cc32a0748d882b23057f335ad4221c853aacfcd1dbbe6453c7c844676d424"}},"shard-input":"image-il","if":"inputs.il"},
        "image-smoke-evaluation": {"required-steps":["smoke"],"reports":[],"shards":["image-evaluation"],"bindings":{"smoke":{"run-sha256":"d885770600d73e8a9bafd10ac3c2b04c462748f81ebbdd335628eed1122b86d8"}},"shard-input":"image-evaluation","if":"inputs.evaluation"},
        "image-smoke-vla": {"required-steps":["smoke"],"reports":[],"shards":["image-vla"],"bindings":{"smoke":{"run-sha256":"97ff7f31b32fd3644ef05510865716c689537ad8e911bd651bd19de2910adf7d"}},"shard-input":"image-vla","if":"inputs.vla"},
        "image-smoke-osmo-replay": {"required-steps":["smoke"],"reports":[],"shards":["image-osmo-replay"],"bindings":{"smoke":{"run-sha256":"ed15e103bc01c56ed16779cabed1284a1e99f09028d5b95e872651b3ef0bf9af"}},"shard-input":"image-osmo-replay","if":"inputs.osmo_replay"},
        "build-smoke-dataviewer": {"required-steps":["smoke"],"reports":[],"shards":["compose-dataviewer"],"bindings":{"smoke":{"run-sha256":"b7216f799eac17c137dd8e7a4efe5a4fc0ed9d24277ef6e46e314c57987bef5e"}},"shard-input":"compose-dataviewer","if":"inputs.dataviewer"}
      },
      "aggregate": {"job":"outcome","producer":"evidence","needs":["import-smoke","image-smoke-rl","image-smoke-il","image-smoke-evaluation","image-smoke-vla","image-smoke-osmo-replay","build-smoke-dataviewer"],"expected-shards":"{\n  \"import-smoke\": [\"cpu-rl\", \"cpu-il\", \"cpu-vla\", \"cpu-evaluation\", \"cpu-vlm-judge\", \"cpu-osmo-replay\"],\n  \"image-smoke-rl\": ${{ inputs.rl && '[\"image-rl\"]' || '[]' }},\n  \"image-smoke-il\": ${{ inputs.il && '[\"image-il\"]' || '[]' }},\n  \"image-smoke-evaluation\": ${{ inputs.evaluation && '[\"image-evaluation\"]' || '[]' }},\n  \"image-smoke-vla\": ${{ inputs.vla && '[\"image-vla\"]' || '[]' }},\n  \"image-smoke-osmo-replay\": ${{ inputs.osmo_replay && '[\"image-osmo-replay\"]' || '[]' }},\n  \"build-smoke-dataviewer\": ${{ inputs.dataviewer && '[\"compose-dataviewer\"]' || '[]' }}\n}"}
    },
    "workflow-refs-check": {"output-job":"workflow-refs-check","jobs":{"workflow-refs-check":{"producer":"outcome","required-steps":["workflow-contract","contract-tests"],"reports":[],"shards":["default"],"bindings":{"workflow-contract":{"run-sha256":"c95c6a04d8c76c1d0750f873af864cf3be3461ad39be15072c2fa70bf9a0fb70"},"contract-tests":{"run-sha256":"c36b9c0d11820d388f0cc6a5f85c7b64461e9944c380789ce33f48ef61817f27"}}}}},
    "spell-check": {"output-job":"spell-check","jobs":{"spell-check":{"producer":"outcome","required-steps":["spell-check"],"reports":[{"path":"logs/spell-check-results.txt","kind":"file"}],"shards":["default"],"bindings":{"spell-check":{"run-sha256":"4ee2cd998a7921bd383e7a75aa43359b8af0d85293b7ba4999f70d0cd4932bce"}}}}},
    "markdown-lint": {"output-job":"markdown-lint","jobs":{"markdown-lint":{"producer":"outcome","required-steps":["markdown-lint"],"reports":[],"shards":["default"],"bindings":{"markdown-lint":{"run-sha256":"771ae43c4e1d00c1e2b51414a8f0b0c54c6f6df8f05db2a712c8d1ffe8f1e9c2"}}}}},
    "toml-format": {"output-job":"toml-format","jobs":{"toml-format":{"producer":"outcome","required-steps":["toml-format"],"reports":[],"shards":["default"],"bindings":{"toml-format":{"run-sha256":"789013ccab42d30dad2c2519a5effd9d777f13ddc03d064915412bd14192391c"}}}}},
    "table-format": {"output-job":"table-format","jobs":{"table-format":{"producer":"outcome","required-steps":["table-format"],"reports":[{"path":"table-format-output.txt","kind":"file"}],"shards":["default"],"bindings":{"table-format":{"run-sha256":"335bbfcac59553cad389ffcd6951b36aa860f1f9cee46da2b2279c1a60d50ea2"}}}}},
    "frontmatter-validation": {"output-job":"frontmatter-validation","jobs":{"frontmatter-validation":{"producer":"outcome","required-steps":["frontmatter"],"reports":[{"path":"logs/frontmatter-validation-results.json","kind":"json"}],"shards":["default"],"bindings":{"frontmatter":{"run-sha256":"9fe403b3e555609caf2258d081305e2755745ae6d585392bd2fa74745d41e1d0"}}}}},
    "msdate-freshness-check": {"output-job":"msdate-freshness","jobs":{"msdate-freshness":{"producer":"outcome","required-steps":["freshness"],"reports":[{"path":"logs/msdate-freshness-results.json","kind":"json"}],"shards":["default"],"bindings":{"freshness":{"run-sha256":"55ad82932bf5ff5977f8865d9f25bc58231102f9c3613469056a8011b9a8315b"}}}}},
    "ps-script-analyzer": {"output-job":"psscriptanalyzer","jobs":{"psscriptanalyzer":{"producer":"outcome","required-steps":["analyze"],"reports":[{"path":"logs/psscriptanalyzer-results.json","kind":"json"}],"shards":["default"],"bindings":{"analyze":{"run-sha256":"b28ec17103640f435dc375a851c20cf64fe934959cf8b1e1fc6033a1086fdfcd"}}}}},
    "yaml-lint": {"output-job":"yaml-lint","jobs":{"yaml-lint":{"producer":"outcome","required-steps":["lint"],"reports":[{"path":"logs/yaml-lint-results.json","kind":"json"}],"shards":["default"],"bindings":{"lint":{"run-sha256":"c089b6cc295e27beec8c602ffb64e361ddfd4b85d2067dba28ece5470016008e"}}}}},
    "link-lang-check": {"output-job":"link-lang-check","jobs":{"link-lang-check":{"producer":"outcome","required-steps":["check"],"reports":[{"path":"logs/link-lang-check-results.json","kind":"json"}],"shards":["default"],"bindings":{"check":{"run-sha256":"b3347f906720ee273cc30c844e228f3327c1515d9f038ceed002c97ac3658808"}}}}},
    "markdown-link-check": {"output-job":"markdown-link-check","jobs":{"markdown-link-check":{"producer":"outcome","required-steps":["link-check"],"reports":[{"path":"logs/markdown-link-check-results.json","kind":"json"}],"shards":["default"],"bindings":{"link-check":{"run-sha256":"2bb4256488552d126dbd3636254a06fd8f8da489e8c7722fbb01a52e287f2ce2"}}}}},
    "dependency-review": {"output-job":"dependency-review","jobs":{"dependency-review":{"producer":"outcome","required-steps":["review"],"reports":[],"shards":["default"],"bindings":{"review":{"uses":"actions/dependency-review-action@a1d282b36b6f3519aa1f3fc636f609c47dddb294","with-sha256":"2b49c129b45708ac26ebc91d0cb6417d1eb98c2da297b334d43e7676696794ae"}}}}},
    "dependency-pinning-scan": {"output-job":"scan","jobs":{"scan":{"producer":"outcome","required-steps":["pinning"],"reports":[{"path":"logs/dependency-pinning-results.json","kind":"json"}],"shards":["default"],"bindings":{"pinning":{"run-sha256":"12f85f105bb53bba6887162730ba20c53b5d754ca677d2b511a84a1b5abdafcb"}}}}},
    "container-scan": {
      "output-job":"aggregate",
      "jobs": {
        "discover":{"producer":"outcome","required-steps":["extract"],"reports":[{"path":"logs/container/manifest.json","kind":"json"}],"shards":["discovery"],"bindings":{"extract":{"run-sha256":"19b5f4b108a4a51aecc270016101b614636162d94de1be89728498454a9eb030"}},"shard-input":"discovery"},
        "scan":{"producer":"outcome","required-steps":["scan"],"reports":[{"path":"logs/container/{shard}.sarif","kind":"sarif","tool":"Trivy"}],"discovery":{"job":"discover","shards-output":"shards","targets-output":"targets"},"bindings":{"scan":{"uses":"aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25","with-sha256":"99e82994321a89cb5443d1accf6aeb97a78d3b370c31b4116d063962328c514c"}},"shard-input":"${{ matrix.shard }}","target-input":"${{ matrix.image }}","matrix":{"include":"${{ fromJSON(needs.discover.outputs.images) }}"},"if":"needs.discover.result == 'success'"}
      },
      "aggregate":{"job":"aggregate","producer":"outcome","shard":"aggregate","needs":["discover","scan"],"expected-shards":"{\"discover\":[\"discovery\"],\"scan\":${{ needs.discover.outputs.shards || '[]' }}}","expected-targets":"{\"scan\":${{ needs.discover.outputs.targets || '{}' }}}"}
    },
    "pester-tests": {"output-job":"aggregate","jobs":{"pester":{"producer":"outcome","required-steps":["install-pester","install-yaml","pester","coverage-policy"],"reports":[{"path":"logs/pester-results-{shard}.xml","kind":"nunit"}],"shards":["ubuntu-latest"],"bindings":{"install-pester":{"run-sha256":"7f574a2648a7564a50c3574df7f8881b491ceb0743f1f60381ea6e408430e768"},"install-yaml":{"run-sha256":"4486f16cb7d077c934b3aa1925f62eb753bd4308004a3b5faaf547d3bb26a0b2"},"pester":{"run-sha256":"09b72073fe7f62e44c98810c95d789892a757decb244790ab2b8452cf3df67c4","if":"!inputs.changed-files-only || steps.changed-files.outputs.has-changes == 'true'"},"coverage-policy":{"run-sha256":"0a7dc2ea32951a7bef889db588a855a8f05e87616ad6cdce6d9bb3a451b4ebe7","if":"always()"}},"shard-input":"${{ matrix.os }}","matrix":{"os":["ubuntu-latest"]}}},"aggregate":{"job":"aggregate","producer":"outcome","needs":["pester"],"expected-shards":"{\"pester\":[\"ubuntu-latest\"]}"}},
    "dataviewer-frontend-tests": {"output-job":"frontend-checks","jobs":{"frontend-checks":{"producer":"outcome","required-steps":["install","lint","type-check","format","test","build"],"reports":[{"path":"logs/dataviewer-frontend-results.xml","kind":"junit"}],"shards":["default"],"bindings":{"install":{"run-sha256":"9db3f780def6105eee3cc930de4d0982607760820fddaa3facdd3813ccb40628"},"lint":{"run-sha256":"326d9800e732eb9d5a5eb56384a547a097ed84be317cb2852cea5bb574831812"},"type-check":{"run-sha256":"d2fd93c17805c97259399b3ed9ef1cbc3790f80f71f2b0c59cb7e26177428d4e"},"format":{"run-sha256":"09fdec6d43d8178d34239d8a54af8460d889b88f70a6af40d60395d74989cbf6"},"test":{"run-sha256":"403d36336e4283ae246f798bc21b74d1eebbca3c9b1253120e38741ae94ee1fb"},"build":{"run-sha256":"16c0e4305ac213dff39fc82b69b6e08aeeb8758e33cd72d7c409752a70e9f054"}}}}},
