    "pytest-training": {"output-job":"pytest-training","jobs":{"pytest-training":{"producer":"outcome","required-steps":["install","test"],"reports":[{"path":"logs/pytest-training-results.xml","kind":"junit"}],"shards":["default"],"bindings":{"install":{"run-sha256":"e222a514ebbcacf96741e32b2693e45676af44477ba107b6f87d22e7e4fd173c"},"test":{"run-sha256":"0611b32140bb8a3e0e36842922b35ad8595043bf9b718e5ea94bf6194c749030"}}}}},
