############################################
# SDG Workflow — Environment Configuration
#
# Copy to configs/sdg.env (git-ignored) and fill in values:
#   cp configs/sdg.env.example configs/sdg.env
# Used by scripts/sdg.sh. The SDG workflow repo stays external.
############################################

# Absolute path to the external sdg-workflow checkout (required).
SDG_WORKFLOW_DIR=

# Kubeconfig of the target cluster (required, single file).
KUBECONFIG=

# Required secrets.
NGC_API_KEY=
HF_TOKEN=

# Optional secrets.
OSMO_TOKEN=
VLM_API_KEY=
LLM_API_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Airflow controller image (passed through to make).
AIRFLOW_IMAGE_REPOSITORY=
AIRFLOW_IMAGE_TAG=

# NFS storage overrides (passed through to make).
NFS_NAMESPACE=nfs-system
NFS_STORAGE_CLASS=nfs
NFS_EXPORT_PATH=/srv/nfs/k8s
NFS_NODE_HOSTNAME=
NFS_SERVER=

# Airflow REST API used by `sdg.sh trigger`.
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
SDG_DAG_ID=autonomous_vehicle_dataset_generation_dag_k8s
