{
  "schema_version": 1,
  "base_ref": "origin/main",
  "root_routes": [
    {
      "pattern": "^package\\.json$",
      "categories": [
        "tooling"
      ]
    },
    {
      "pattern": "^package-lock\\.json$",
      "categories": [
        "tooling",
        "dataviewer"
      ]
    },
    {
      "pattern": "^(pyproject\\.toml|uv\\.lock)$",
      "categories": [
        "tooling"
      ]
    },
    {
      "pattern": "^\\.github/(workflows|actions)/",
      "categories": [
        "tooling"
      ]
    }
  ],
  "categories": [
    {
      "id": "baseline",
      "title": "Baseline for every Dependabot PR",
      "always": true,
      "summary": "Lock files match manifests, dependency feeds stay public, pins stay pinned, and known vulnerabilities are surfaced.",
      "dependabot": [],
      "paths": [],
      "setup": [],
      "notes": [
        "Dependency Review runs only in CI because it needs the GitHub API."
      ],
      "checks": [
        {
          "id": "uv-lock-consistency",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Every uv.lock matches its pyproject.toml.",
          "command": [
            "npm",
            "run",
            "lint:uvlock"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "pwsh",
            "uv"
          ],
          "ci_lanes": [
            "uv-lock-consistency"
          ]
        },
        {
          "id": "npm-lock-root",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "The root package-lock.json matches the root and workspace manifests.",
          "command": [
            "npm",
            "ci",
            "--dry-run",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": []
        },
        {
          "id": "npm-lock-docs",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "The docs package-lock.json matches its manifest.",
          "command": [
            "npm",
            "ci",
            "--dry-run",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund"
          ],
          "cwd": "docs/docusaurus",
          "requires": [
            "npm"
          ],
          "ci_lanes": []
        },
        {
          "id": "public-dependency-feeds",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Dependencies resolve only from public feeds.",
          "command": [
            "npm",
            "run",
            "lint:public-dependency-feeds"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "pwsh"
          ],
          "ci_lanes": [
            "public-dependency-feeds"
          ]
        },
        {
          "id": "dependency-pinning",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Dependency pinning scan with the PR lane's inputs and exit status.",
          "command": [
            "pwsh",
            "-NoProfile",
            "-File",
            "scripts/security/Invoke-DependencyPinningWorkflow.ps1"
          ],
          "cwd": ".",
          "requires": [
            "pwsh"
          ],
          "ci_lanes": [
            "dependency-pinning"
          ],
          "set_env": {
            "PINNING_THRESHOLD": "95",
            "PINNING_DEPENDENCY_TYPES": "github-actions,npm,pip,shell-downloads,shell-inline-pip,gh-extension,powershell-modules,docker,dockerfile-base-image,workflow-npm-commands",
            "PINNING_SOFT_FAIL": "false",
            "PINNING_UPLOAD_SARIF": "false",
            "PINNING_EXCLUDE_PATHS": "scripts/tests/Fixtures/**,shared/ci/tests/Fixtures/**"
          }
        },
        {
          "id": "osv-scan",
          "tier": "cpu",
          "gpu": false,
          "optional": true,
          "description": "OSV vulnerability scan of every lock file.",
          "command": [
            "npm",
            "run",
            "lint:vuln"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "osv-scanner"
          ],
          "ci_lanes": [
            "osv-scanner"
          ],
          "notes": "CI runs this on every PR; install osv-scanner to run it locally."
        }
      ]
    },
    {
      "id": "tooling",
      "title": "Repository tooling and GitHub Actions",
      "summary": "Root npm dev tools, the root uv dev group (pytest, ruff, and the e2e harness's Azure SDK), and GitHub Actions pins.",
      "dependabot": [
        {
          "ecosystem": "npm",
          "directory": "/"
        },
        {
          "ecosystem": "uv",
          "directory": "/"
        },
        {
          "ecosystem": "github-actions",
          "directory": "/"
        }
      ],
      "paths": [],
      "setup": [
        {
          "command": [
            "npm",
            "ci",
            "--no-audit",
            "--no-fund"
          ],
          "cwd": "."
        }
      ],
      "notes": [
        "A GitHub Actions bump is only fully proven by a CI run on a pushed branch; these checks prove syntax, references, and the workflow contract.",
        "Root uv runtime pins (azure-ai-ml, pyjwt, urllib3) are exercised live by any environment check, because the e2e harness runs in the root environment."
      ],
      "checks": [
        {
          "id": "markdown-lint",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Markdown lint with the bumped markdownlint-cli2.",
          "command": [
            "npm",
            "run",
            "lint:md"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "markdown-lint"
          ]
        },
        {
          "id": "spell-check",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Spell check with the bumped cspell.",
          "command": [
            "npm",
            "run",
            "spell-check"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "spell-check"
          ]
        },
        {
          "id": "yaml-lint",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Workflow and YAML lint (actionlint).",
          "command": [
            "npm",
            "run",
            "lint:yaml"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "pwsh",
            "actionlint"
          ],
          "ci_lanes": [
            "yaml-lint"
          ]
        },
        {
          "id": "workflow-contract-lint",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Workflow graph and CI contract validation.",
          "command": [
            "npm",
            "run",
            "lint:ci"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "node"
          ],
          "ci_lanes": [
            "workflow-refs-check"
          ]
        },
        {
          "id": "workflow-contract-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "CI contract unit tests.",
          "command": [
            "npm",
            "run",
            "test:ci"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "node"
          ],
          "ci_lanes": [
            "workflow-refs-check"
          ]
        },
        {
          "id": "python-lint",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Ruff lint with the CI-pinned version.",
          "command": [
            "npm",
            "run",
            "lint:py"
          ],
          "cwd": ".",
          "requires": [
            "npm",
            "uv"
          ],
          "ci_lanes": [
            "python-lint"
          ]
        },
        {
          "id": "root-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Root unit tests, excluding live e2e tests.",
          "command": [
            "uv",
            "run",
            "--frozen",
            "pytest",
            "-o",
            "addopts=",
            "-m",
            "not e2e",
            "tests"
          ],
          "cwd": ".",
          "requires": [
            "uv"
          ],
          "ci_lanes": []
        },
        {
          "id": "shared-ci-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Shared CI script tests.",
          "command": [
            "uv",
            "run",
            "--frozen",
            "pytest",
            "-o",
            "addopts=",
            "shared/ci/tests"
          ],
          "cwd": ".",
          "requires": [
            "uv"
          ],
          "ci_lanes": [
            "pytest-shared-ci"
          ]
        },
        {
          "id": "dm-tools-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Data management tool tests.",
          "command": [
            "uv",
            "run",
            "--frozen",
            "pytest",
            "-o",
            "addopts=",
            "data-management/tools/tests"
          ],
          "cwd": ".",
          "requires": [
            "uv"
          ],
          "ci_lanes": [
            "pytest-dm-tools"
          ]
        }
      ]
    },
    {
      "id": "dataviewer",
      "title": "Dataviewer frontend, backend, and images",
      "summary": "The React frontend workspace, the FastAPI backend, and their container images.",
      "dependabot": [
        {
          "ecosystem": "npm",
          "directory": "/"
        },
        {
          "ecosystem": "uv",
          "directory": "/data-management/viewer/backend"
        },
        {
          "ecosystem": "docker",
          "directory": "/data-management/viewer/backend"
        },
        {
          "ecosystem": "docker",
          "directory": "/data-management/viewer/frontend"
        }
      ],
      "paths": [
        "data-management/viewer/"
      ],
      "setup": [
        {
          "command": [
            "npm",
            "ci",
            "--no-audit",
            "--no-fund"
          ],
          "cwd": "."
        },
        {
          "command": [
            "uv",
            "sync",
            "--frozen",
            "--group",
            "dev",
            "--extra",
            "analysis",
            "--extra",
            "hdf5",
            "--extra",
            "export",
            "--extra",
            "auth"
          ],
          "cwd": "data-management/viewer/backend"
        }
      ],
      "notes": [
        "Frontend checks mirror CI rather than npm run validate, which skips the coverage gate."
      ],
      "checks": [
        {
          "id": "dataviewer-frontend-lint",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend lint, as CI runs it.",
          "command": [
            "npm",
            "run",
            "lint",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-frontend-type-check",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend type-check, as CI runs it.",
          "command": [
            "npm",
            "run",
            "type-check",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-frontend-format",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend format, as CI runs it.",
          "command": [
            "npm",
            "run",
            "format",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-frontend-test",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend test, as CI runs it.",
          "command": [
            "npm",
            "run",
            "test",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-frontend-test-coverage",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend test:coverage, as CI runs it.",
          "command": [
            "npm",
            "run",
            "test:coverage",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-frontend-build",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Frontend build, as CI runs it.",
          "command": [
            "npm",
            "run",
            "build",
            "--workspace",
            "robotic-training-data-tool"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "dataviewer-frontend-tests"
          ]
        },
        {
          "id": "dataviewer-backend-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Backend tests with the 90% coverage gate.",
          "command": [
            "uv",
            "run",
            "--no-sync",
            "pytest",
            "--cov=src",
            "--cov-report=term-missing",
            "--cov-fail-under=90"
          ],
          "cwd": "data-management/viewer/backend",
          "requires": [
            "uv"
          ],
          "ci_lanes": [
            "dataviewer-backend-pytests"
          ]
        },
        {
          "id": "dataviewer-compose-smoke",
          "tier": "cpu",
          "gpu": false,
          "optional": true,
          "description": "Build the compose images on their pinned bases and wait for healthy services.",
          "command": [
            "shared/ci/smoke-docker.sh"
          ],
          "cwd": ".",
          "requires": [
            "docker"
          ],
          "ci_lanes": [
            "smoke"
          ],
          "notes": "CI runs this on PRs that touch the dataviewer; it builds both images."
        }
      ]
    },
    {
      "id": "docs",
      "title": "Docusaurus documentation site",
      "summary": "The docs site build, unit tests, accessibility lint, and production browser tests, including the Express static server.",
      "dependabot": [
        {
          "ecosystem": "npm",
          "directory": "/docs/docusaurus"
        }
      ],
      "paths": [
        "docs/docusaurus/"
      ],
      "setup": [
        {
          "command": [
            "npm",
            "ci",
            "--no-audit",
            "--no-fund"
          ],
          "cwd": "docs/docusaurus"
        }
      ],
      "notes": [
        "Local browser runs can differ from CI on contrast; the container runner compares failures against the base ref."
      ],
      "checks": [
        {
          "id": "docs-validate",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Docs lint, label registry, typecheck, build, unit tests, and Mermaid accessibility.",
          "command": [
            "npm",
            "run",
            "validate:docs"
          ],
          "cwd": ".",
          "requires": [
            "npm"
          ],
          "ci_lanes": [
            "docusaurus-tests"
          ]
        },
        {
          "id": "docs-e2e-container",
          "tier": "cpu",
          "gpu": false,
          "optional": true,
          "description": "Production browser tests in a Linux Playwright container, compared with the base ref.",
          "command": [
            "bash",
            "docs/docusaurus/scripts/run-e2e-container.sh",
            "--compare-base",
            "{base_ref}",
            "--output-dir",
            "{run_dir}/docs-e2e"
          ],
          "cwd": ".",
          "requires": [
            "docker",
            "git",
            "jq"
          ],
          "ci_lanes": [
            "docusaurus-tests"
          ],
          "not_run_exit_codes": [
            3
          ],
          "notes": "CI runs these tests on docs pull requests. Locally one snapshot takes about an hour on Apple Silicon: system Chrome needs amd64 emulation, and CI retries rerun the serial 13-minute site crawl when the local contrast gate fails."
        }
      ]
    },
    {
