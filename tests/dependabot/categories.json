    {
      "id": "evaluation",
      "title": "Evaluation packages",
      "summary": "The evaluation dev and test lock and the optional VLM judge runtime. GPU evaluation runs inside the rl and il lifecycles.",
      "dependabot": [
        {
          "ecosystem": "uv",
          "directory": "/evaluation"
        },
        {
          "ecosystem": "uv",
          "directory": "/evaluation/vlm_judge"
        }
      ],
      "paths": [
        "evaluation/"
      ],
      "setup": [],
      "notes": [
        "The evaluation lock has no runtime consumer; GPU evaluation jobs install the training locks, so no environment check is needed here."
      ],
      "checks": [
        {
          "id": "evaluation-tests",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Evaluation tests in its Linux-only locked environment.",
          "command": [
            "bash",
            "-c",
            "export UV_PROJECT_ENVIRONMENT=/tmp/evaluation-venv && uv sync --frozen --only-group dev && uv run --frozen --only-group dev pytest -o addopts="
          ],
          "cwd": "evaluation",
          "requires": [
            "uv"
          ],
          "ci_lanes": [
            "evaluation-pytests"
          ],
          "container": {
            "image": "ghcr.io/astral-sh/uv:python3.12-bookworm-slim",
            "platform": "linux/amd64"
          }
        },
        {
          "id": "evaluation-import-smoke",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Install and import the evaluation lock with CPU wheels.",
          "command": [
            "shared/ci/smoke-image.sh",
            "evaluation",
            "--mode",
            "cpu"
          ],
          "cwd": ".",
          "requires": [
            "docker"
          ],
          "ci_lanes": [
            "smoke"
          ]
        },
        {
          "id": "vlm-judge-import-smoke",
          "tier": "cpu",
          "gpu": false,
          "optional": false,
          "description": "Install and import the VLM judge runtime with CPU wheels.",
          "command": [
            "shared/ci/smoke-image.sh",
            "vlm-judge",
            "--mode",
            "cpu"
          ],
          "cwd": ".",
          "requires": [
            "docker"
          ],
          "ci_lanes": [
            "smoke"
          ]
        },
        {
          "id": "evaluation-image-smoke",
          "tier": "cpu",
          "gpu": false,
          "optional": true,
          "description": "Import the IL runtime lock in the evaluation production image.",
          "command": [
            "shared/ci/smoke-image.sh",
            "evaluation"
          ],
          "cwd": ".",
          "requires": [
            "docker"
          ],
          "ci_lanes": [
            "smoke"
          ],
          "notes": "CI runs the runtime-image smoke on PRs that touch this domain; it pulls a multi-gigabyte image."
        }
      ]
    },
